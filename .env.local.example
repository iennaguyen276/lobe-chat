# LobeChat Local Development Configuration Example
# Copy this file to .env.local and update with your actual values
# DO NOT commit .env.local to version control

########################################
########## Required Settings ###########
########################################

# OpenAI API Configuration (Required for AI functionality)
# Get your API key from https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-xxxxxxxxx

########################################
########## Optional Settings ###########
########################################

# Access Code (Optional)
# Add an access code to lock your application
# You can set a long password to avoid leaking
# If this value contains a comma, it is a password array
# ACCESS_CODE=your-secret-code

# API Key Selection Mode (Optional)
# Specify your API Key selection method
# Options: random, turn
# API_KEY_SELECT_MODE=random

# OpenAI Proxy (Optional)
# Use a proxy to connect to the OpenAI API
# OPENAI_PROXY_URL=https://api.openai.com/v1

# Custom Models (Optional)
# Add your custom model names, separated by commas
# OPENAI_MODEL_LIST=gpt-3.5-turbo,gpt-4

########################################
########### Security Settings ##########
########################################

# Content Security Policy (Optional)
# Set to '1' to enable CSP headers
# Default is '0' (disabled)
# ENABLED_CSP=0

# SSRF Protection (Optional)
# Set to '1' to allow private IP addresses (disable SSRF protection)
# WARNING: Only enable in trusted environments
# Default is '0' (SSRF protection enabled)
# SSRF_ALLOW_PRIVATE_IP_ADDRESS=0

########################################
######## Database Configuration ########
########################################

# PostgreSQL Database URL (Optional, for server-side features)
# Format: postgresql://username:password@host:port/database
# DATABASE_URL=postgresql://postgres:password@localhost:5432/lobechat

# Key Vaults Secret (Optional, required if using database)
# Generate with: openssl rand -base64 32
# KEY_VAULTS_SECRET=

########################################
####### Authentication Settings ########
########################################

# NextAuth (Optional, for multi-user support)
# NEXT_PUBLIC_ENABLE_NEXT_AUTH=0
# NEXT_AUTH_SECRET=

# Auth0 (Optional)
# AUTH_AUTH0_ID=
# AUTH_AUTH0_SECRET=
# AUTH_AUTH0_ISSUER=

########################################
######## Other AI Providers ############
########################################

# Anthropic (Claude)
# ANTHROPIC_API_KEY=

# Google AI
# GOOGLE_API_KEY=

# Ollama (Local LLM)
# OLLAMA_PROXY_URL=http://127.0.0.1:11434

# For more AI provider configurations, see .env.example
